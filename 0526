import os

path = "."
count = 0

with os.scandir(path) as entries:
    for entry in entries:
        if entry.is_file() and entry.name.endswith(".txt"):
            print(entry.name)
            count += 1

print(f"\n총 {count}개의 .txt 파일을 찾았습니다.")
