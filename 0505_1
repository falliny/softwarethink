import random

n = int(input())

def MatrixFill():
    mat = []
    for i in range(n):
        row = []
        for j in range(n):
            row.append(random.randrange(1, n*n*10))
        mat.append(row)
    return mat

def MatrixPrint(mat):
    for i in range(n):
        for j in range(n):
            print(f"{mat[i][j]:5d}", end=' ')
        print()
    print()

A = MatrixFill()
B = MatrixFill()
C = MatrixFill()

AB_C = [[0]*n for i in range(n)]

for i in range(n):
    for j in range(n):
        for k in range(n):
            AB_C[i][j] += A[i][k] * B[k][j]
        AB_C[i][j] += C[i][j]

MatrixPrint(A)
MatrixPrint(B)
MatrixPrint(C)
MatrixPrint(AB_C)
